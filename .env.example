# Copy to .env and add your private keys. Never commit .env.
GROQ_API_KEY=
TAVILY_API_KEY=
# Override if this model is unavailable on your Groq account.
GROQ_MODEL=openai/gpt-oss-20b
# Optional persistent storage overrides:
# PICNIC_GRAPH_DB_PATH=data/workflow.sqlite3
# PICNIC_DB_PATH=data/picnics.sqlite3

# Email-only sign-in and group invitations.
# Local preview works ONLY from a loopback client and localhost URL; no email is sent.
# Set AUTH_EMAIL_MODE=local while testing locally.
# AUTH_EMAIL_MODE=local
# Production: use smtp and a fixed public HTTPS URL (never local preview).
# AUTH_EMAIL_MODE=smtp
# APP_BASE_URL=https://your-picnic-app.example
# SMTP_HOST=smtp.your-provider.example
# SMTP_PORT=587
# SMTP_TLS=starttls
# SMTP_FROM=hello@your-domain.example
# SMTP_USER=
# SMTP_PASSWORD=
